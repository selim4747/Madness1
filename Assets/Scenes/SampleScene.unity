  storyNPCPrefab: {fileID: 7832952169967227410, guid: 91daa34377d52f042842edaeeaf7ef73, type: 3}
  doorPoint: {fileID: 820975574}
  counterPoint: {fileID: 1614989143}
  dailyNPCName: Afor
  gunlukSohbetBloklari:
  - aciklama: Gun 1-10
    satirlar:
    - "Nas\u0131ls\u0131n?"
  - aciklama: Gun 1-10
    satirlar: []
  - aciklama: Gun 1-10
    satirlar: []
  - aciklama: Gun 1-10
    satirlar: []
