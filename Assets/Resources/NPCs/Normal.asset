  - musteriIsmi: Kaelan
    cinsiyet: 1
    yas: 30
    loreHikayesi: Luyot ailesinden, Feilin kuzeni
    sevilenTurler: 050000000200000004000000
    sevmedigiTurler: 
    sabirCarpani: 1
