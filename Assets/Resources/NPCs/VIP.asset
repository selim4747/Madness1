  m_Name: VIP
  m_EditorClassIdentifier: Assembly-CSharp::CustomerData
  karakterHavuzu:
  - musteriIsmi: "Gal\u0131n E\u015Fci"
    cinsiyet: 1
    loreHikayesi: "Zafk\u0131n\u0131n amcas\u0131."
    sevilenTurler: 0500000002000000
    sevmedigiTurler: 
    sabirCarpani: 1
    odemeCarpani: 1
    incelemeSuresiCarpani: 1
    meslek: 
    ozelDiyaloglar:
    - "Bu k\xFCt\xFCphanenin yemek raf\u0131 \xE7ok k\xFC\xE7\xFCk, benim mutfa\u011F\u0131mdaki
      kitapl\u0131\u011F\u0131m daha b\xFCy\xFCk."
    - "Ye\u011Fenim Zafk\u0131'y\u0131 tan\u0131r m\u0131s\u0131n? Gemi a\u015F\xE7\u0131s\u0131
      oldu, ben h\xE2l\xE2 anlam veremedim ama gurur da duyuyorum."
    - "Param yeterli, endi\u015Felenme \u2014 en pahal\u0131 kitab\u0131 bile alabilirim."
    - "Karde\u015Fim h\xE2l\xE2 k\xFC\xE7\xFCk bir d\xFCkk\xE2nda \xE7al\u0131\u015F\u0131yor,
      ben teklif ettim b\xFCy\xFCmesini ama kabul etmedi."
    - "Necale, bu kitab\u0131 okuduktan sonra mutfa\u011F\u0131ma bir tarif daha
      eklerim belki."
    - "\u0130nsanlar zengin olunca de\u011Fi\u015Fti\u011Fimi d\xFC\u015F\xFCn\xFCyor,
      oysa h\xE2l\xE2 ayn\u0131 tavay\u0131 \xE7eviren adam\u0131m i\xE7imde."
    - "Bu kitab\u0131 \xFC\xE7 kopya alaca\u011F\u0131m, biri bana, ikisi lokantalar\u0131ma."
    - "Necale, i\u015Fin zor g\xF6r\xFCn\xFCyor ama en az\u0131ndan kimse senden
      yemek be\u011Fenmeni istemiyor her g\xFCn."
    - "Param bol ama vaktim yok, h\u0131zl\u0131 se\xE7 bana bir \u015Feyler."
    tisortSprite: {fileID: 0}
    sosyal: 0
    bahceDiyaloglari: []
    gunlukKonusmaLimiti: 3
    ozelGunKarakteri: 0
    gorunecegiGunler: 
    herKacGundeBir: 0
    enErkenGun: 0
    enGecGun: 0
  - musteriIsmi: Vezna Bura
    cinsiyet: 1
    loreHikayesi: "Evrende s\u0131radan bir vatanda\u015F."
    sevilenTurler: 0500000001000000
    sevmedigiTurler: 
    sabirCarpani: 1
    odemeCarpani: 1
    incelemeSuresiCarpani: 1
    meslek: 
    ozelDiyaloglar:
    - "Bura ailesinin eski bir ferdiyim, duymu\u015F olabilirsiniz."
    - "Necale, bu k\xFCt\xFCphanede eski aile kay\u0131tlar\u0131 var m\u0131 acaba?
      Meraktan soruyorum, ciddi bir ara\u015Ft\u0131rma de\u011Fil."
    - "Param konusu beni s\u0131k\u0131yor, l\xFCtfen sadece hesab\u0131 g\xF6nder."
    - "Tarih kitaplar\u0131n\u0131 severim, ge\xE7mi\u015F insanlar\u0131n hatalar\u0131n\u0131
      tekrarlamamak i\xE7in okurum."
    - "Ailem beni buraya gelirken hep tuhaf bulur, 's\u0131radan insanlar\u0131n
      yeri' derler. Ben kat\u0131lm\u0131yorum."
    - "Param \xE7oktur ama zaman\u0131m azd\u0131r \u2014 kitab\u0131 se\xE7, ben
      g\xFCvenirim sana."
    tisortSprite: {fileID: 0}
    sosyal: 1
    bahceDiyaloglari: []
    gunlukKonusmaLimiti: 3
    ozelGunKarakteri: 0
    gorunecegiGunler: 
    herKacGundeBir: 0
    enErkenGun: 0
    enGecGun: 0
  - musteriIsmi: "Huj E\u015Fci"
    cinsiyet: 0
    loreHikayesi: "Evrende s\u0131radan bir vatanda\u015F."
    sevilenTurler: 080000000000000005000000
    sevmedigiTurler: 
    sabirCarpani: 1.4399137
    odemeCarpani: 0.9953921
    incelemeSuresiCarpani: 1.2932786
    meslek: "M\xFChendis"
    ozelDiyaloglar:
    - "Bug\xFCn sadece bakmaya geldim, almayaca\u011F\u0131m san\u0131r\u0131m."
    - "Kap\u0131dan girer girmez huzur buluyorum, tuhaf de\u011Fil mi?"
    - "Bug\xFCn k\u0131sa bir ziyaret olacak, i\u015Fim var sonra."
    - "Kitap se\xE7erken hep \xE7ok uzun s\xFCr\xFCyorum, kusura bakma."
    - "Param yetmezse indirim yapar m\u0131s\u0131n acaba?"
    - "Bug\xFCn can\u0131m s\u0131kk\u0131nd\u0131, buraya gelince ge\xE7ti biraz."
    - "Kitaplar\u0131 kiralamak m\u0131, sat\u0131n almak m\u0131 daha iyi?"
    - "Bug\xFCn erken geldim, sessiz olaca\u011F\u0131n\u0131 biliyordum."
    - "Bu \u015Fehirde herkes bir \u015Fey biliyor gibi davran\u0131yor, sence de
      \xF6yle mi?"
    - "Sence bir k\xFCt\xFCphane sadece kitaplar\u0131n de\u011Fil, insanlar\u0131n
      da haf\u0131zas\u0131n\u0131 m\u0131 tutar?"
    - "Sence her hik\xE2yenin bir kahraman\u0131 olmak zorunda m\u0131?"
    - "\u0130nsan neden yaln\u0131z kalmaktan bu kadar korkar sence?"
    - "Bu raf\u0131n en \xFCst k\u0131sm\u0131na hi\xE7 ula\u015Fam\u0131yorum, yard\u0131m
      eder misin?"
    - "Sence her insan\u0131n bir kaderi mi var, yoksa hepimiz kendi hik\xE2yemizi
      mi yaz\u0131yoruz?"
    - "Sence bir kitab\u0131n kapa\u011F\u0131 i\xE7eri\u011Finden daha m\u0131 \xF6nemli
      bazen?"
    tisortSprite: {fileID: 0}
